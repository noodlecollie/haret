set(CMAKE_SYSTEM_NAME WindowsCE)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(CMAKE_C_COMPILER_ID GCC)
set(CMAKE_CXX_COMPILER_ID GCC)

set(TOOLCHAIN_PREFIX "arm-mingw32ce-" CACHE STRING "ARM toolchain prefix")

set(CMAKE_SYSROOT "/opt/cegcc")

set(CMAKE_C_COMPILER                ${TOOLCHAIN_PREFIX}gcc)
set(CMAKE_ASM_COMPILER              ${CMAKE_C_COMPILER})
set(CMAKE_CXX_COMPILER              ${TOOLCHAIN_PREFIX}g++)
set(CMAKE_LINKER                    ${TOOLCHAIN_PREFIX}g++)
set(CMAKE_OBJCOPY                   ${TOOLCHAIN_PREFIX}objcopy)
set(CMAKE_SIZE                      ${TOOLCHAIN_PREFIX}size)

set(CMAKE_EXECUTABLE_SUFFIX_ASM     ".exe")
set(CMAKE_EXECUTABLE_SUFFIX_C       ".exe")
set(CMAKE_EXECUTABLE_SUFFIX_CXX     ".exe")

set(TARGET_FLAGS "--march=armv5")

set(CMAKE_C_FLAGS_DEBUG "-g ${TARGET_FLAGS}")
set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG ${TARGET_FLAGS}")
set(CMAKE_C_FLAGS_RELWITHDEBINFO "-O2 -g -DNDEBUG ${TARGET_FLAGS}")
set(CMAKE_C_FLAGS_MINSIZEREL "-Os -DNDEBUG ${TARGET_FLAGS}")
set(CMAKE_CXX_FLAGS_DEBUG "-g ${TARGET_FLAGS}")
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG ${TARGET_FLAGS}")
set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "-O2 -g -DNDEBUG ${TARGET_FLAGS}")
set(CMAKE_CXX_FLAGS_MINSIZEREL "-Os -DNDEBUG ${TARGET_FLAGS}")

set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
