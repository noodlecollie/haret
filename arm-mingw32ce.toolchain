set(CMAKE_SYSTEM_NAME WindowsCE)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(CMAKE_C_COMPILER_ID GCC)
set(CMAKE_CXX_COMPILER_ID GCC)
set(CMAKE_SYSROOT "/opt/cegcc")

set(CMAKE_C_COMPILER arm-mingw32ce-gcc)
set(CMAKE_ASM_COMPILER arm-mingw32ce-as)
set(CMAKE_CXX_COMPILER arm-mingw32ce-g++)
set(CMAKE_RC_COMPILER arm-mingw32ce-windres)
set(CMAKE_LINKER arm-mingw32ce-g++)
set(CMAKE_OBJCOPY arm-mingw32ce-objcopy)
set(CMAKE_SIZE arm-mingw32ce-size)
set(CMAKE_STRIP arm-mingw32ce-strip)
set(CMAKE_DLLTOOL arm-mingw32ce-dlltool)

set(CMAKE_EXECUTABLE_SUFFIX_ASM     ".exe")
set(CMAKE_EXECUTABLE_SUFFIX_C       ".exe")
set(CMAKE_EXECUTABLE_SUFFIX_CXX     ".exe")

set(TARGET_FLAGS --march=armv4)

# Optimisation levels here are kept at -O1,
# because the original HaRET Makefile had this.
# Since we'll be doing some very specific hacky
# things in this executable, the optimisation
# level may be crucial to operation. Perhaps
# we could test changing these in future.
set(CMAKE_C_FLAGS_DEBUG_INIT -g ${TARGET_FLAGS})
set(CMAKE_C_FLAGS_RELEASE_INIT -O1 -DNDEBUG ${TARGET_FLAGS})
set(CMAKE_C_LINK_FLAGS -Wl,--major-subsystem-version=2,--minor-subsystem-version=10)

set(CMAKE_CXX_FLAGS_DEBUG_INIT ${CMAKE_C_FLAGS_DEBUG_INIT})
set(CMAKE_CXX_FLAGS_RELEASE_INIT ${CMAKE_CXX_FLAGS_RELEASE_INIT})
set(CMAKE_CXX_LINK_FLAGS ${CMAKE_C_LINK_FLAGS})

set(CMAKE_RC_FLAGS_INIT -l 0x409)

set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
